[Unit]
Description=Tinc Hub — Dashboard (port 9010)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/tinc-hub/config.env
WorkingDirectory=/opt/tinc-hub/dashboard
ExecStart=/opt/tinc-hub/venv/bin/python /opt/tinc-hub/dashboard/app.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/tinc-hub/dashboard.log
StandardError=append:/var/log/tinc-hub/dashboard.log

[Install]
WantedBy=multi-user.target
