[Unit]
Description=Tinc Hub — Service Watchdog
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/tinc-hub/config.env
ExecStart=/opt/tinc-hub/agents/service-watchdog/agent.py
Restart=always
RestartSec=30
StandardOutput=append:/var/log/tinc-hub/service-watchdog.log
StandardError=append:/var/log/tinc-hub/service-watchdog.log

[Install]
WantedBy=multi-user.target
