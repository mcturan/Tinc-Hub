# ============================================================
# Tinc Hub — Ortak Konfigürasyon
# Bu dosyayı config.env olarak kopyala ve doldur
# cp config.env.template config.env
# ============================================================

# --- Router Guardian ---
ROUTER_IP=192.168.1.1
ROUTER_USER=admin
ROUTER_PASS=your_password_here
# Reboot saati (cron formatı)
ROUTER_REBOOT_CRON="0 6 * * *"
# Akıllı reboot: bağlantı kesilirse tetikle (true/false)
ROUTER_SMART_REBOOT=true
# Ping interval (saniye)
ROUTER_PING_INTERVAL=60

# --- WAN Tracker ---
WAN_CHECK_INTERVAL=300
# Dış erişim kontrolü için portlar (virgülle ayrılmış)
WAN_CHECK_PORTS=80,443

# --- Disk Sentinel ---
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
DISK_CHECK_INTERVAL=3600
# Temizlik yapılacak ekstra dizinler (virgülle ayrılmış)
DISK_EXTRA_CLEANUP_DIRS=/tmp

# --- RAM Cleaner ---
RAM_WARN_PERCENT=85
RAM_CHECK_INTERVAL=300
SWAP_CLEAN_THRESHOLD=70
# Ollama servisi adı (boşalt desteği için)
OLLAMA_SERVICE=ollama

# --- Service Watchdog ---
# İzlenecek servisler (virgülle ayrılmış)
WATCHDOG_SERVICES=nginx,firinna-pos,docker,ollama,plexmediaserver,casaos
WATCHDOG_CHECK_INTERVAL=60
# Çöken servisi otomatik yeniden başlat (true/false)
WATCHDOG_AUTO_RESTART=true

# --- Dashboard ---
DASHBOARD_PORT=9010
DASHBOARD_HOST=0.0.0.0
DASHBOARD_SECRET_KEY=change_me_please_use_random_string

# --- Genel ---
TINC_HUB_DB_PATH=/var/lib/tinc-hub/kole.db
TINC_HUB_LOG_DIR=/var/log/tinc-hub
TINC_HUB_INSTALL_DIR=/opt/tinc-hub
