[Unit]
Description=TINC Köle — RAM Cleaner Agent
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/kole/config.env
ExecStart=/opt/kole/agents/ram-cleaner/agent.py
Restart=always
RestartSec=30
StandardOutput=append:/var/log/kole/ram-cleaner.log
StandardError=append:/var/log/kole/ram-cleaner.log

[Install]
WantedBy=multi-user.target
