[Unit]
Description=TINC Köle — Router Guardian
Documentation=https://github.com/tinc-kole
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/kole/config.env
ExecStart=/opt/kole/agents/router-guardian/agent.py
Restart=always
RestartSec=30
# Reboot işlemi uzun sürebilir, kill timeout yüksek tutuldu
TimeoutStopSec=60
StandardOutput=append:/var/log/kole/router-guardian.log
StandardError=append:/var/log/kole/router-guardian.log

[Install]
WantedBy=multi-user.target
