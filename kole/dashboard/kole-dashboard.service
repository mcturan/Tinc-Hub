[Unit]
Description=TINC Köle — Dashboard (port 9010)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/kole/config.env
WorkingDirectory=/opt/kole/dashboard
ExecStart=/opt/kole/venv/bin/python /opt/kole/dashboard/app.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/kole/dashboard.log
StandardError=append:/var/log/kole/dashboard.log

[Install]
WantedBy=multi-user.target
