<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp">

    <!-- Görev Tamamlama Butonu (Çember Tik Butonu) -->
    <LinearLayout
        android:id="@+id/widget_item_check_box"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/widget_btn_bg">

        <TextView
            android:id="@+id/widget_item_check_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Görev Metni ve Etiketleri -->
    <LinearLayout
        android:id="@+id/widget_item_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Görev Başlığı"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <!-- Vade / Durum Rozeti (Örn: Yarın, Gecikmiş, vb.) -->
            <TextView
                android:id="@+id/widget_item_due_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bugün"
                android:textColor="#D97706"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingEnd="6dp"
                android:visibility="gone" />

            <!-- Sayfa / Kategori Rozeti -->
            <TextView
                android:id="@+id/widget_item_page_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genel"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
